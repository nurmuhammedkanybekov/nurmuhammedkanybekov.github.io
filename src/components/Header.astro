---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  isHome: boolean;
  hasNotes: boolean;
  hasResume: boolean;
}
const { isHome, hasNotes, hasResume } = Astro.props;
const base = isHome ? '' : '/';
const links = [
  { name: 'About', url: `${base}#about` },
  { name: 'Experience', url: `${base}#jobs` },
  { name: 'Work', url: `${base}#projects` },
  ...(hasNotes ? [{ name: 'Notes', url: '/notes/' }] : []),
  { name: 'Contact', url: `${base}#contact` },
];
---

<header class="site-header" data-header>
  <nav class="nav" aria-label="Main">
    <a href="/" class="nav-logo fade-in" aria-label={`${site.name}, home`}>
      <Logo size={42} />
    </a>

    <div class="nav-links">
      <ol>
        {
          links.map((link, i) => (
            <li class="fade-in" style={`--d:${(i + 1) * 80}ms`}>
              <a href={link.url}>{link.name}</a>
            </li>
          ))
        }
      </ol>
      <button class="theme-toggle fade-in" style={`--d:${(links.length + 1) * 80}ms`} data-theme-toggle aria-label="Switch color theme">
        <span class="icon-sun"><Icon name="sun" size={18} /></span>
        <span class="icon-moon"><Icon name="moon" size={18} /></span>
      </button>
      {
        hasResume && (
          <a class="btn btn-sm fade-in" style={`--d:${(links.length + 2) * 80}ms`} href={site.resumePath} target="_blank" rel="noopener">
            Resume
          </a>
        )
      }
    </div>

    <div class="nav-mobile fade-in">
      <button class="theme-toggle" data-theme-toggle aria-label="Switch color theme">
        <span class="icon-sun"><Icon name="sun" size={20} /></span>
        <span class="icon-moon"><Icon name="moon" size={20} /></span>
      </button>
      <button class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <span class="hamburger-box"><span class="hamburger-inner"></span></span>
      </button>
    </div>
  </nav>

  <aside id="mobile-menu" class="mobile-menu" aria-hidden="true" data-menu>
    <nav aria-label="Mobile">
      <ol>
        {
          links.map((link) => (
            <li>
              <a href={link.url} data-menu-link tabindex="-1">
                {link.name}
              </a>
            </li>
          ))
        }
      </ol>
      {
        hasResume && (
          <a class="btn btn-lg" href={site.resumePath} target="_blank" rel="noopener" data-menu-link tabindex="-1">
            Resume
          </a>
        )
      }
    </nav>
  </aside>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    z-index: 11;
    width: 100%;
    height: var(--nav-height);
    padding: 0 50px;
    display: flex;
    align-items: center;
    background-color: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: var(--transition);
  }
  :global(html.is-scrolled) .site-header {
    height: var(--nav-scroll-height);
    box-shadow: 0 10px 30px -10px var(--shadow);
  }
  :global(html.is-scrolled-down) .site-header {
    transform: translateY(calc(var(--nav-scroll-height) * -1));
    box-shadow: none;
  }
  :global(html.is-at-top) .site-header {
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  @media (max-width: 1080px) {
    .site-header {
      padding: 0 40px;
    }
  }
  @media (max-width: 768px) {
    .site-header {
      padding: 0 25px;
    }
  }
  @media (max-width: 480px) {
    .site-header {
      padding: 0 16px;
    }
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 12;
    font-family: var(--font-mono);
  }
  .nav-logo {
    display: block;
    transition: var(--transition);
  }
  .nav-logo:hover,
  .nav-logo:focus-visible {
    transform: translateY(-2px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .nav-links ol {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: item;
  }
  .nav-links li {
    margin: 0 5px;
    font-size: var(--fz-xs);
    counter-increment: item;
  }
  .nav-links li a {
    padding: 10px;
    color: var(--text-strong);
  }
  .nav-links li a:hover,
  .nav-links li a:focus-visible {
    color: var(--accent);
  }
  .nav-links li a::before {
    content: '0' counter(item) '.';
    margin-right: 5px;
    color: var(--accent);
    font-size: var(--fz-xxs);
  }
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--text-strong);
    transition: var(--transition);
  }
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--accent);
    background-color: var(--accent-tint);
  }
  .icon-moon {
    display: none;
  }
  :global(html[data-theme-resolved='light']) .icon-sun {
    display: none;
  }
  :global(html[data-theme-resolved='light']) .icon-moon {
    display: block;
  }

  .nav-mobile {
    display: none;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 768px) {
    .nav-mobile {
      display: flex;
    }
  }

  .hamburger {
    position: relative;
    z-index: 13;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 15px;
    margin-right: -15px;
  }
  .hamburger-box {
    display: inline-block;
    position: relative;
    width: var(--hamburger-width);
    height: 24px;
  }
  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    position: absolute;
    right: 0;
    height: 2px;
    border-radius: 4px;
    background-color: var(--accent);
    transition: transform 0.22s cubic-bezier(0.55, 0.055, 0.675, 0.19), width 0.1s ease, top 0.1s ease, bottom 0.1s ease, opacity 0.1s ease;
  }
  .hamburger-inner {
    top: 50%;
    width: var(--hamburger-width);
  }
  .hamburger-inner::before,
  .hamburger-inner::after {
    content: '';
    display: block;
    left: auto;
  }
  .hamburger-inner::before {
    top: -10px;
    width: 120%;
  }
  .hamburger-inner::after {
    bottom: -10px;
    width: 80%;
  }
  .hamburger[aria-expanded='true'] .hamburger-inner {
    transform: rotate(225deg);
  }
  .hamburger[aria-expanded='true'] .hamburger-inner::before {
    top: 0;
    width: 100%;
    opacity: 0;
  }
  .hamburger[aria-expanded='true'] .hamburger-inner::after {
    bottom: 0;
    width: 100%;
    transform: rotate(-90deg);
  }

  .mobile-menu {
    display: none;
  }
  @media (max-width: 768px) {
    .mobile-menu {
      display: flex;
      justify-content: center;
      align-items: center;
      position: fixed;
      top: 0;
      bottom: 0;
      right: 0;
      z-index: 10;
      width: min(75vw, 400px);
      height: 100vh;
      height: 100dvh;
      padding: 50px 10px;
      background-color: var(--bg-raised);
      box-shadow: -10px 0 30px -15px var(--shadow);
      transform: translateX(100vw);
      visibility: hidden;
      transition: var(--transition);
    }
    :global(body.menu-open) .mobile-menu {
      transform: none;
      visibility: visible;
    }
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    font-family: var(--font-mono);
    text-align: center;
  }
  .mobile-menu ol {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    width: 100%;
    counter-reset: item;
  }
  .mobile-menu li {
    margin: 0 auto 20px;
    counter-increment: item;
    font-size: clamp(var(--fz-sm), 4vw, var(--fz-lg));
  }
  .mobile-menu li a {
    display: inline-block;
    width: 100%;
    padding: 3px 20px 20px;
    color: var(--text-strong);
  }
  .mobile-menu li a::before {
    content: '0' counter(item) '.';
    display: block;
    margin-bottom: 5px;
    color: var(--accent);
    font-size: var(--fz-sm);
  }
</style>
