---
import Ornament from './Ornament.astro';
import { site, contact } from '../data/site';
---

<section id="contact" class="contact">
  <div class="backdrop" aria-hidden="true"><Ornament kind="medallion" /></div>
  <div class="divider reveal"><Ornament kind="divider" /></div>
  <h2 class="overline reveal">04. {contact.overline}</h2>
  <p class="title reveal">{contact.heading}</p>
  <p class="text reveal">{contact.text}</p>
  <a class="btn btn-lg reveal" href={`mailto:${site.email}`}>{contact.button}</a>
</section>

<style>
  .contact {
    position: relative;
    max-width: 600px;
    margin: 0 auto 100px;
    text-align: center;
  }
  @media (max-width: 768px) {
    .contact {
      margin: 0 auto 50px;
    }
  }
  .contact > :not(.backdrop) {
    position: relative;
  }
  .backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 560px;
    max-width: 120vw;
    aspect-ratio: 1;
    transform: translate(-50%, -46%);
    opacity: 0.07;
    pointer-events: none;
  }
  :global([data-theme-resolved='light']) .backdrop {
    opacity: 0.1;
  }
  .divider {
    margin-bottom: 40px;
  }
  .overline {
    display: block;
    margin-bottom: 20px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fz-md);
    font-weight: 400;
  }
  .title {
    margin: 0 0 10px;
    color: var(--heading);
    font-size: clamp(40px, 5vw, 60px);
    font-weight: 600;
    line-height: 1.1;
  }
  .text {
    margin: 20px 0 50px;
    line-height: 1.55;
  }
</style>
