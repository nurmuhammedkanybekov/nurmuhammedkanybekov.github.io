---
interface Props {
  size?: number;
  animated?: boolean;
}
const { size = 42, animated = false } = Astro.props;
---

<svg
  class:list={['logo', { 'logo--animated': animated }]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect class="logo-frame" x="6" y="6" width="88" height="88" rx="20" fill="none" stroke="currentColor" stroke-width="5" pathLength="100"></rect>
  <text class="logo-text" x="50" y="51" text-anchor="middle" dominant-baseline="central" fill="currentColor">NK</text>
</svg>

<style>
  .logo {
    color: var(--accent);
    overflow: visible;
  }
  .logo-text {
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -1px;
  }
  .logo--animated .logo-frame {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw 1s var(--ease) 0.2s forwards;
  }
  .logo--animated .logo-text {
    opacity: 0;
    animation: appear 0.4s ease 1s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
</style>
