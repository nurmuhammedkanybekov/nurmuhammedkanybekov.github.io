---
interface Props {
  size?: number;
  animated?: boolean;
}
const { size = 42, animated = false } = Astro.props;
// Stepped frame after the borders of a shyrdak (Kyrgyz felt carpet), crowned top and
// bottom by a kochkor muuz (ram's horn) pair, around "NK" set in Source Serif 4 and
// converted to outlines so it looks the same everywhere.
const frame = 'M40 6 H22 V14 H14 V22 H6 V78 H14 V86 H22 V94 H40 M60 94 H78 V86 H86 V78 H94 V22 H86 V14 H78 V6 H60';
const horn = 'M100 150 L100 120 C100 90 115 70 140 68 C165 66 176 88 166 104 C158 117 140 114 140 102 C140 93 151 90 155 97';
const letters =
  'M20.84 66V64.72L25.14 64.18H26.08L30.81 64.72V66ZM24.65 66V35.63H26.42V50.39V66ZM39.69 36.06V34.79H49.47V36.06L45.51 36.6H44.58ZM43.88 66.24 26.25 39.77H26.18L23.99 36.42L20.94 36.07V34.79H29.09L44.78 58.3L44.17 58.38V50.12V34.79H45.95V66.24ZM55.82 66Q55.91 63.98 55.96 61.51Q56 59.04 56.01 56.41Q56.01 53.77 56.01 51.32V49.27Q56.01 46.84 56.01 44.27Q56 41.7 55.96 39.26Q55.92 36.81 55.83 34.79H61.33Q61.25 36.8 61.2 39.24Q61.15 41.68 61.15 44.25Q61.14 46.82 61.14 49.27V51.55Q61.14 53.88 61.15 56.46Q61.15 59.03 61.2 61.5Q61.25 63.96 61.33 66ZM52.25 66V64.72L57.62 64.08H59.58L64.8 64.72V66ZM52.25 36.06V34.79H64.91V36.06L59.58 36.71H57.62ZM68.65 66V64.72L73.76 64.08H75.68L80.42 64.72V66ZM69.24 36.06V34.79H79.51V36.06L74.91 36.71L73.93 36.75ZM58.38 58.16 58.32 55.17H59.01L60.1 53.78L74.79 34.79H76.91ZM72.64 66 64.24 49.44 67.48 45.34 78.36 66Z';
---

<svg
  class:list={['logo', { 'logo--animated': animated }]}
  width={size}
  height={size}
  viewBox="-6 -6 112 112"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <path class="logo-frame" d={frame} fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" pathLength="100"></path>
  <g class="logo-horns" fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="round">
    {
      ['translate(50 11) scale(0.2)', 'translate(50 89) scale(0.2 -0.2)'].map((t) => (
        <g transform={`${t} translate(-100 -150)`}>
          <path d={horn} />
          <path d={horn} transform="translate(200 0) scale(-1 1)" />
        </g>
      ))
    }
  </g>
  <path class="logo-text" d={letters} fill="currentColor" transform="translate(5 6) scale(0.9)"></path>
</svg>

<style>
  .logo {
    color: var(--accent);
    overflow: visible;
  }
  .logo--animated .logo-frame {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw 1s var(--ease) 0.2s forwards;
  }
  .logo--animated .logo-text,
  .logo--animated .logo-horns {
    opacity: 0;
    animation: appear 0.4s ease 1s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
</style>
