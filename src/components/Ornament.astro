---
// Kyrgyz line ornaments, drawn in code so they stay sharp and follow the theme.
//  - medallion: the sun from the Kyrgyz flag (40 straight rays) around a tunduk,
//    the crown of the yurt, with two sets of four beams. Between them, ram's horns
//    (kochkor muuz, prosperity) and small tumar triangles (amulets).
//  - horn: one kochkor muuz pair.
//  - divider: a shyrdak-style border of horn pairs, alternating up and down.
// Color comes from `currentColor`, so set `color` on the element or a parent.
interface Props {
  kind: 'medallion' | 'horn' | 'divider';
  class?: string;
  size?: number;
}
const { kind, class: className, size } = Astro.props;

// One horn pair in a 200×200 box, stem base at (100,150), curling up and out.
const horn = 'M100 150 L100 120 C100 90 115 70 140 68 C165 66 176 88 166 104 C158 117 140 114 140 102 C140 93 151 90 155 97';
const hornMirror = 'translate(200 0) scale(-1 1)';

const r1 = (n: number) => Math.round(n * 10) / 10;
const C = 200;

const rays = Array.from({ length: 40 }, (_, i) => {
  const a = (i * 9 * Math.PI) / 180;
  const [s, c] = [Math.sin(a), Math.cos(a)];
  return `M${r1(C + 166 * s)} ${r1(C - 166 * c)} L${r1(C + 194 * s)} ${r1(C - 194 * c)}`;
});

const R = 58;
const beams = [-33, -11, 11, 33].flatMap((d) => {
  const half = Math.sqrt(R ** 2 - d ** 2);
  const bow = d * 0.75;
  return [
    `M${C + d} ${r1(C - half)} Q${r1(C + d + bow)} ${C} ${C + d} ${r1(C + half)}`,
    `M${r1(C - half)} ${C + d} Q${C} ${r1(C + d + bow)} ${r1(C + half)} ${C + d}`,
  ];
});

// Horn pairs around the tunduk: large on the diagonals, small on the axes.
const horns = Array.from({ length: 4 }, (_, i) => [
  `rotate(${45 + i * 90} 200 200) translate(200 132) scale(0.55) translate(-100 -150)`,
  `rotate(${i * 90} 200 200) translate(200 128) scale(0.42) translate(-100 -150)`,
]).flat();
const tumars = Array.from({ length: 8 }, (_, i) => `rotate(${i * 45 + 22.5} 200 200)`);

// Divider border: horn pairs on a centre line, every other one flipped.
const band = Array.from({ length: 5 }, (_, i) => `translate(${30 + i * 60} 40) scale(0.36 ${i % 2 ? -0.36 : 0.36}) translate(-100 -150)`);
---

{
  kind === 'medallion' && (
    <svg
      class:list={['ornament', 'ornament-medallion', className]}
      viewBox="0 0 400 400"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {rays.map((d) => <path d={d} pathLength="1" />)}
      <circle cx="200" cy="200" r="158" pathLength="1" />
      <circle cx="200" cy="200" r="150" pathLength="1" />
      <circle cx="200" cy="200" r={R + 8} pathLength="1" />
      <circle cx="200" cy="200" r={R} pathLength="1" />
      {beams.map((d) => <path d={d} pathLength="1" />)}
      {horns.map((t) => (
        <g transform={t}>
          <path d={horn} pathLength="1" />
          <path d={horn} transform={hornMirror} pathLength="1" />
        </g>
      ))}
      {tumars.map((t) => <path d="M200 66 L206 78 L194 78 Z" transform={t} pathLength="1" />)}
    </svg>
  )
}

{
  kind === 'horn' && (
    <svg
      class:list={['ornament', 'ornament-horn', className]}
      viewBox="40 60 120 120"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d={horn} />
      <path d={horn} transform={hornMirror} />
      <path d="M100 150 L109 161 L100 172 L91 161 Z" fill="currentColor" />
    </svg>
  )
}

{
  kind === 'divider' && (
    <div class:list={['ornament', 'ornament-divider', className]} aria-hidden="true">
      <span class="ornament-rule" />
      <svg viewBox="0 0 300 80" width="150" height="40" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <path d="M0 40 H300" stroke-width="1.6" />
        {band.map((t) => (
          <g transform={t}>
            <path d={horn} />
            <path d={horn} transform={hornMirror} />
          </g>
        ))}
      </svg>
      <span class="ornament-rule" />
    </div>
  )
}

<style>
  .ornament {
    color: var(--accent);
    pointer-events: none;
  }
  .ornament-divider {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }
  .ornament-divider svg {
    flex: none;
  }
  .ornament-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to var(--dir, right), transparent, var(--accent));
    opacity: 0.8;
  }
  .ornament-rule:last-child {
    --dir: left;
  }

  /* The medallion draws itself in once, after the page is ready. */
  :global(html.js) .ornament-medallion.draw :is(circle, path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(html.js body.is-ready) .ornament-medallion.draw :is(circle, path) {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 2.4s var(--ease) 0.4s;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .ornament-medallion.draw :is(circle, path) {
      stroke-dashoffset: 0;
    }
  }
</style>
