---
import { jobs } from '../data/site';
---

<section id="jobs" class="jobs">
  <h2 class="numbered-heading reveal">Experience</h2>

  <ol class="timeline">
    {
      jobs.map((job, i) => (
        <li class:list={['entry', 'reveal', { current: job.current }]} style={`--reveal-delay:${i * 60}ms`}>
          <div class="when">
            <span class="range">{job.range}</span>
          </div>
          <div class="body">
            <span class="marker" aria-hidden="true" />
            <h3 class="title">{job.title}</h3>
            <p class="org">
              {job.url ? (
                <a href={job.url} target="_blank" rel="noopener">
                  {job.company}
                </a>
              ) : (
                job.company
              )}
            </p>
            <p class="summary" set:html={job.summary} />
            {job.ladder && (
              <ol class="ladder" aria-label="Roles, in order">
                {job.ladder.map((step) => (
                  <li>
                    <span class="step-role">{step.role}</span>
                    <span class="step-org">{step.org}</span>
                  </li>
                ))}
              </ol>
            )}
            <ul class="points">
              {job.points.map((p) => (
                <li set:html={p} />
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .jobs {
    max-width: 900px;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    display: grid;
    grid-template-columns: 170px 1fr;
  }
  @media (max-width: 768px) {
    .entry {
      grid-template-columns: 1fr;
    }
  }

  .when {
    padding: 6px 28px 0 0;
    text-align: right;
  }
  .range {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    line-height: 1.6;
    white-space: nowrap;
  }
  .current .range {
    color: var(--accent);
  }
  @media (max-width: 768px) {
    .when {
      order: 2;
      padding: 0 0 0 30px;
      text-align: left;
    }
  }

  .body {
    position: relative;
    padding: 0 0 56px 36px;
    border-left: 1px solid var(--border);
  }
  .entry:last-child .body {
    padding-bottom: 0;
    border-image: linear-gradient(to bottom, var(--border) 60%, transparent) 1;
  }
  @media (max-width: 768px) {
    .body {
      display: contents;
    }
  }

  /* Diamond marker on the line: filled for current roles. */
  .marker {
    position: absolute;
    top: 9px;
    left: -6px;
    width: 11px;
    height: 11px;
    border: 1px solid var(--accent);
    background-color: var(--bg);
    transform: rotate(45deg);
  }
  .current .marker {
    background-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-tint);
  }

  .title {
    margin: 0;
    font-size: var(--fz-xxl);
    font-weight: 600;
    line-height: 1.3;
  }
  .org {
    margin: 2px 0 14px;
    color: var(--accent);
    font-size: var(--fz-lg);
    font-style: italic;
  }
  .org a:hover,
  .org a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .summary {
    margin: 0 0 16px;
    color: var(--text-strong);
    font-size: var(--fz-lg);
    line-height: 1.55;
  }

  /* Role progression: a small stepper with diamond nodes on a gold line. */
  .ladder {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    list-style: none;
    margin: 4px 0 22px;
    padding: 0;
  }
  .ladder li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 22px 14px 0 0;
  }
  .ladder li::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 0;
    width: 9px;
    height: 9px;
    border: 1px solid var(--accent);
    background-color: var(--bg);
    transform: rotate(45deg);
    z-index: 1;
  }
  .ladder li:last-child::before {
    background-color: var(--accent);
  }
  .ladder li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 14px;
    right: 4px;
    height: 1px;
    background: linear-gradient(to right, var(--accent-line), var(--accent));
  }
  .step-role {
    color: var(--heading);
    font-size: var(--fz-md);
    font-weight: 600;
    line-height: 1.25;
  }
  .ladder li:not(:last-child) .step-role {
    color: var(--text-strong);
    font-weight: 500;
  }
  .step-org {
    margin-top: 4px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--fz-xxs);
    line-height: 1.4;
  }
  @media (max-width: 600px) {
    .ladder {
      grid-auto-flow: row;
      gap: 14px;
    }
    .ladder li {
      padding: 0 0 0 26px;
    }
    .ladder li::before {
      top: 5px;
    }
    .ladder li:not(:last-child)::after {
      top: 16px;
      left: 5px;
      right: auto;
      bottom: -12px;
      width: 1px;
      height: auto;
      background: linear-gradient(to bottom, var(--accent-line), var(--accent));
    }
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fz-lg);
  }
  .points li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
    line-height: 1.55;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    background-color: var(--accent);
    transform: rotate(45deg);
  }
  .points :global(strong),
  .summary :global(strong) {
    color: var(--heading);
    font-weight: 600;
  }

  /* Phone: one column, with the line and markers running down the left. */
  @media (max-width: 768px) {
    .entry {
      position: relative;
      padding: 0 0 44px 30px;
      border-left: 1px solid var(--border);
    }
    .entry:last-child {
      padding-bottom: 0;
      border-image: linear-gradient(to bottom, var(--border) 60%, transparent) 1;
    }
    .when {
      padding: 0;
      margin: 0 0 10px;
    }
    .marker {
      left: -6px;
      top: 9px;
    }
    .title {
      order: 1;
    }
    .entry > .when {
      order: 2;
    }
    .org {
      order: 3;
    }
    .summary {
      order: 4;
    }
    .ladder {
      order: 5;
    }
    .points {
      order: 6;
    }
  }
</style>
