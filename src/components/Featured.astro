---
import Icon from './Icon.astro';
import Cover from './Cover.astro';
import { featured } from '../data/site';
---

<section id="projects" class="featured">
  <h2 class="numbered-heading reveal">Some things I've built</h2>

  <ul class="list">
    {
      featured.map((p) => {
        const link = p.live || p.github;
        return (
          <li class="project reveal">
            <div class="content">
              <div>
                <p class="overline">{p.overline}</p>
                <h3 class="title">
                  {link ? (
                    <a href={link} target="_blank" rel="noopener">
                      {p.title}
                    </a>
                  ) : (
                    p.title
                  )}
                </h3>
                <div class="description">
                  <p>{p.description}</p>
                </div>
                <ul class="tech">
                  {p.tech.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                {(p.github || p.live) && (
                  <div class="links">
                    {p.github && (
                      <a href={p.github} aria-label={`${p.title} source code on GitHub`} target="_blank" rel="noopener">
                        <Icon name="github" size={20} />
                      </a>
                    )}
                    {p.live && (
                      <a href={p.live} aria-label={`Open ${p.title}`} target="_blank" rel="noopener" class="cta">
                        <Icon name="external" size={20} />
                        <span>Play it</span>
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>

            <div class="image">
              {link ? (
                <a href={link} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                  <Cover kind={p.cover} title={p.title} />
                </a>
              ) : (
                <div>
                  <Cover kind={p.cover} title={p.title} />
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .project {
    position: relative;
    display: grid;
    grid-gap: 10px;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
  }
  .project:not(:last-of-type) {
    margin-bottom: 100px;
  }
  @media (max-width: 768px) {
    .project:not(:last-of-type) {
      margin-bottom: 70px;
    }
    .project {
      box-shadow: 0 10px 30px -15px var(--shadow);
    }
  }
  @media (max-width: 480px) {
    .project:not(:last-of-type) {
      margin-bottom: 30px;
    }
  }

  /* odd/even flip */
  .project:nth-of-type(odd) .content {
    grid-column: 7 / -1;
    text-align: right;
  }
  .project:nth-of-type(odd) .tech {
    justify-content: flex-end;
  }
  .project:nth-of-type(odd) .tech li {
    margin: 0 0 5px 20px;
  }
  .project:nth-of-type(odd) .links {
    justify-content: flex-end;
    margin-left: 0;
    margin-right: -10px;
  }
  .project:nth-of-type(odd) .image {
    grid-column: 1 / 8;
  }
  @media (max-width: 1080px) {
    .project:nth-of-type(odd) .content {
      grid-column: 5 / -1;
    }
  }
  @media (max-width: 768px) {
    .project:nth-of-type(odd) .content {
      grid-column: 1 / -1;
      padding: 40px 40px 30px;
      text-align: left;
    }
    .project:nth-of-type(odd) .tech {
      justify-content: flex-start;
    }
    .project:nth-of-type(odd) .tech li {
      margin: 0 10px 5px 0;
    }
    .project:nth-of-type(odd) .links {
      justify-content: flex-start;
      margin-left: -10px;
      margin-right: 0;
    }
    .project:nth-of-type(odd) .image {
      grid-column: 1 / -1;
    }
  }

  .content {
    position: relative;
    grid-column: 1 / 7;
    grid-row: 1 / -1;
  }
  @media (max-width: 1080px) {
    .content {
      grid-column: 1 / 9;
    }
  }
  @media (max-width: 768px) {
    .content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%;
      grid-column: 1 / -1;
      padding: 40px 40px 30px;
      z-index: 5;
    }
  }
  @media (max-width: 480px) {
    .content {
      padding: 30px 25px 20px;
    }
  }

  .overline {
    margin: 10px 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    font-weight: 400;
  }
  .title {
    color: var(--heading);
    font-size: clamp(24px, 5vw, 28px);
  }
  @media (min-width: 769px) {
    .title {
      margin: 0 0 20px;
    }
  }
  .title a {
    position: static;
  }
  .title a::before {
    content: '';
    display: block;
    position: absolute;
    z-index: 0;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
  }
  @media (min-width: 769px) {
    .title a::before {
      display: none;
    }
  }

  .description {
    position: relative;
    z-index: 2;
    padding: 25px;
    border-radius: var(--radius);
    background-color: var(--bg-raised);
    color: var(--text-strong);
    font-size: var(--fz-lg);
    line-height: 1.55;
    box-shadow: 0 10px 30px -15px var(--shadow);
    transition: var(--transition);
  }
  .description:hover {
    box-shadow: 0 20px 30px -15px var(--shadow);
  }
  @media (max-width: 768px) {
    .description {
      padding: 20px 0;
      background-color: transparent;
      box-shadow: none;
    }
    .description:hover {
      box-shadow: none;
    }
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
    margin: 25px 0 10px;
    padding: 0;
    list-style: none;
  }
  .tech li {
    margin: 0 20px 5px 0;
    color: var(--text-strong);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .tech {
      margin: 10px 0;
    }
    .tech li {
      margin: 0 10px 5px 0;
    }
  }

  .links {
    display: flex;
    align-items: center;
    position: relative;
    margin-top: 10px;
    margin-left: -10px;
    color: var(--heading);
  }
  .links a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    position: relative;
    z-index: 3;
  }
  .links .cta span {
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
  }

  .image {
    grid-column: 6 / -1;
    grid-row: 1 / -1;
    position: relative;
    z-index: 1;
    box-shadow: 0 10px 30px -15px var(--shadow);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .image {
      grid-column: 1 / -1;
      height: 100%;
    }
    .image > a::after,
    .image > div::after {
      background-color: var(--bg-raised) !important;
      mix-blend-mode: normal !important;
      opacity: 0.94 !important;
    }
    .image :global(svg) {
      opacity: 0.3;
    }
    .image :global(svg) {
      height: 100%;
    }
  }
  .image > a,
  .image > div {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }
  .image > a::after,
  .image > div::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background-color: var(--accent);
    mix-blend-mode: multiply;
    opacity: 0.12;
    transition: var(--transition);
  }
  .image :global(svg) {
    filter: grayscale(35%) brightness(0.9);
    transition: var(--transition);
  }
  .project:hover .image > a::after,
  .project:hover .image > div::after {
    opacity: 0;
  }
  .project:hover .image :global(svg) {
    filter: none;
  }
</style>
